{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["node", "unplugin-icons/types/vue"],
    "lib": ["ES2022", "DOM"],

    // The vendored code is PlayHex's, so it is checked with PlayHex's own settings.
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,

    "paths": {
      // PlayHex's workspace packages, vendored at their paths under src/packages.
      "@playhex/pixi-board": ["./src/packages/pixi-board/index.ts"],
      "@playhex/pixi-board/conditional-moves": ["./src/packages/pixi-board/conditional-moves.ts"],
      "@playhex/pixi-board/shading-patterns": ["./src/packages/pixi-board/shading-patterns.ts"],
      "@playhex/move-notation": ["./src/packages/move-notation/index.ts"],
      "@playhex/conditional-moves": ["./src/packages/conditional-moves/index.ts"],
      "@playhex/shading-patterns": ["./src/packages/shading-patterns/index.ts"],
      "vue-router": ["./src/stubs/vue-router.ts"],
      "@unhead/vue": ["./src/stubs/unhead.ts"],
      // The engine bridge and the WebGPU net.
      "@engine/*": ["../src/*"],
      // What vite.config.ts aliases them to, for the CPU fallback's net.
      "@tensorflow/tfjs": ["./node_modules/@tensorflow/tfjs-core"],
      "@tensorflow/tfjs-core/*": ["./node_modules/@tensorflow/tfjs-core/*"],
      "@tensorflow/tfjs-backend-wasm": ["./node_modules/@tensorflow/tfjs-backend-wasm"],
      "@tensorflow/tfjs-backend-wasm/*": ["./node_modules/@tensorflow/tfjs-backend-wasm/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "vite.config.ts"],
  "exclude": ["**/test/**"]
}
